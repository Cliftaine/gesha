<%# Frame de promoción 1080×1920 — markup verbatim de carta-promociones.html %>
<% if (slide.package) { %><div class="frame" data-slide="<%= index %>" data-zone="promo-frame"><iframe src="/promo-pkg/<%= slide.package %>/?promo=<%= encodeURIComponent(slide.id) %>&v=<%= locals.version || 0 %><%- slide.previewValues ? '&amp;pv=' + encodeURIComponent(JSON.stringify(slide.previewValues)) : '' %>" sandbox="allow-scripts" scrolling="no" title="" style="position: absolute; left: 0px; top: 0px; width: <%= slide.packageSize.w %>px; height: <%= slide.packageSize.h %>px; transform-origin: 0px 0px; transform: scale(<%= +(locals.stage.w / slide.packageSize.w).toFixed(4) %>); border: 0px; background: transparent; pointer-events: none;"></iframe></div><% } else { %><div class="frame" data-slide="<%= index %>" data-zone="promo-frame"><img src="<%= slide.image %>" alt="" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;"><div style="position: absolute; inset: 0px; z-index: 3; background: linear-gradient(to top, rgba(20, 18, 15, 0.86) 0%, rgba(20, 18, 15, 0.25) 48%, rgba(20, 18, 15, 0.32) 100%);"><div style="position: absolute; top: 74px; left: 84px; display: flex; align-items: center; gap: 16px;"><% if (slide.logo) { %><img src="<%= slide.logo %>" alt="" style="height: 56px; max-width: 260px; object-fit: contain;"><% } else { %><img src="<%= typeof markSrc !== 'undefined' ? markSrc : '/assets/manta-mark.png' %>"<%- typeof legacyLive !== 'undefined' && legacyLive ? ' class="fx-manta"' : '' %> alt="" style="height: 56px; <%- typeof markFilter !== 'undefined' ? markFilter : 'filter: invert(1); ' %>opacity: 0.92;"><% } %><span style="font-family: Archivo, system-ui, sans-serif; font-size: 16px; letter-spacing: 0.4em; text-transform: uppercase; color: rgba(243, 237, 227, 0.85);">Promociones</span></div><div data-zone="promo-text" style="position: absolute; left: 84px; right: 84px; bottom: 134px;"><div style="font-family: Archivo, system-ui, sans-serif; font-size: 21px; font-weight: 600; letter-spacing: 0.34em; text-transform: uppercase; color: rgb(152, 106, 76); margin-bottom: 20px;"><%= slide.kicker %></div><div style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 300; font-size: <%= slide.headlineSize %>px; line-height: 0.9; letter-spacing: -0.02em; max-width: 880px;"><%= slide.headline %></div><div style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 400; font-style: italic; font-size: 60px; line-height: 1.04; margin: 12px 0px 18px; color: rgb(243, 237, 227);"><%= slide.subtitle %></div><div style="font-family: Archivo, system-ui, sans-serif; font-weight: 400; font-size: 25px; line-height: 1.45; max-width: 620px; color: rgba(243, 237, 227, 0.85);"><%= slide.description %></div><div style="font-family: Archivo, system-ui, sans-serif; font-size: 16px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(243, 237, 227, 0.6); margin-top: 24px;"><%= slide.footnote %></div></div></div></div><% } %>
