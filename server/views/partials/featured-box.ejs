<%# Caja "Comida del día" (alimentos) — estilos verbatim; posición absoluta bottom 140px %>
<%
  const fbClasses = [];
  if (typeof fxDelay === 'number') fbClasses.push('fx-in');
  if (featured.accent) fbClasses.push('fx-accent');
%>
<div data-zone="featured"<%- fbClasses.length ? ` class="${fbClasses.join(' ')}"` : '' %> style="position: absolute; left: 64px; right: 64px; bottom: 140px;<%- typeof fxDelay === 'number' ? ` --fx-delay: ${fxDelay}s;` : '' %>"><div style="background: rgba(122, 90, 60, 0.07); border: 1px solid rgba(122, 90, 60, 0.28); border-radius: 20px; padding: 30px 48px 34px; text-align: center;"><div style="position: relative; display: flex; align-items: center; justify-content: center; min-height: 62px;"><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 600; font-size: 62px; line-height: 0.95; color: rgb(42, 38, 32); letter-spacing: -0.01em; white-space: nowrap;"><span><%= featured.title %></span></span><span style="position: absolute; right: 0px; top: 50%; transform: translateY(-50%); font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 50px; line-height: 1; color: rgb(122, 90, 60);">$<%= featured.price %></span></div><% if (guisadoHoy) { %><div style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-style: italic; font-size: 30px; color: rgb(122, 90, 60); margin-top: 4px;">Hoy: <%= guisadoHoy %></div><% } %><div style="display: flex; align-items: center; justify-content: center; gap: 16px; margin: 16px auto 20px; max-width: 360px;"><span style="flex: 1 1 0%; height: 1px; background: rgba(122, 90, 60, 0.28);"></span><span style="font-family: Archivo, system-ui, sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(126, 116, 104); flex: 0 0 auto;"><span><%= featured.label %></span></span><span style="flex: 1 1 0%; height: 1px; background: rgba(122, 90, 60, 0.28);"></span></div><div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px 30px;"><% for (const inc of featured.includes) { %><div style="display: flex; align-items: center; justify-content: center;"><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-style: italic; font-size: 29px; line-height: 1.1; color: rgb(42, 38, 32); white-space: nowrap;"><%= inc %></span></div><% } %></div><div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 22px;"><span style="width: 22px; height: 1px; background: rgba(122, 90, 60, 0.28);"></span><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-style: italic; font-size: 21px; color: rgb(126, 116, 104); white-space: nowrap;"><%= featured.footnote %></span><span style="width: 22px; height: 1px; background: rgba(122, 90, 60, 0.28);"></span></div></div></div>
