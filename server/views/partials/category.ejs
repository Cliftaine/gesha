<%#
  Categoría completa: header (icono + título + hairline + leyenda CH/G opcional),
  grupos con label opcional (Frappes → Café/Otros/Frutales) e items.
  Los SVGs de tazas son copias verbatim del original de bebidas.
%>
<%
  const sizeIds = cat.legendSizes || (menu.sizes || []).map((s) => s.id);
  const cupSvg = {
    small: '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#9A7A55" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8h8l-1 11.5a1.5 1.5 0 0 1-1.5 1.4h-3a1.5 1.5 0 0 1-1.5-1.4z"></path><path d="M7.5 8h9"></path></svg>',
    large: '<svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="#9A7A55" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10l-1.2 15.6a1.6 1.6 0 0 1-1.6 1.4h-4.4a1.6 1.6 0 0 1-1.6-1.4z"></path><path d="M6.5 4h11"></path></svg>',
  };
  const sizeById = Object.fromEntries((menu.sizes || []).map((s) => [s.id, s]));
  const boxStyle = cat.boxed
    ? 'margin-bottom: ' + S.catMb + '; background: rgba(122, 90, 60, 0.07); border: 1px solid rgba(122, 90, 60, 0.28); border-radius: 16px; padding: 12px 22px 4px;'
    : 'margin-bottom: ' + S.catMb + ';';
%>
<%
  const catClasses = [];
  if (typeof fxDelay === 'number') catClasses.push('fx-in');
  if (cat.accent) catClasses.push('fx-accent');
%>
<div data-zone="cat-<%= catId %>"<%- catClasses.length ? ` class="${catClasses.join(' ')}"` : '' %> style="<%- boxStyle %><%- typeof fxDelay === 'number' ? ` --fx-delay: ${fxDelay}s;` : '' %>"><div style="margin-bottom: <%= S.headMb %>;"><div style="display: flex; align-items: center; gap: 12px;"><img src="/assets/icons/<%= cat.icon %>.png" alt="" style="width: 52px; height: 52px; flex: 0 0 auto; display: block;"><span style="font-family: Archivo, system-ui, sans-serif; font-size: 23px; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; color: rgb(42, 38, 32); flex: 0 0 auto;"><%= cat.title %></span><span style="flex: 1 1 0%; height: 1px; background: rgba(122, 90, 60, 0.28);"></span><% if (cat.legendSizes && cat.legendSizes.length) { %><span style="display: flex; gap: 12px; flex: 0 0 auto;"><% for (const sid of cat.legendSizes) { %><span style="display: inline-flex; align-items: center; gap: 5px;"><%- cupSvg[(sizeById[sid] || {}).cup || 'large'] %><span style="font-family: Archivo, system-ui, sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(171, 162, 148);"><%= sid %></span></span><% } %></span><% } %></div></div><div><% for (const group of cat.groups) { %><% if (group.label) { %><div><div style="display: flex; align-items: center; gap: 10px; margin: 12px 0px 4px;"><span style="width: 18px; height: 2px; background: rgb(154, 122, 85);"></span><span style="font-family: Archivo, system-ui, sans-serif; font-size: 15px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(126, 116, 104); flex: 0 0 auto;"><%= group.label %></span></div><% } %><% for (const item of group.items) { %><%- include('item-row', { item, S, sizeIds: item.prices ? sizeIds : [] }) %><% } %><% if (group.note) { %><div style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-style: italic; font-size: 18px; color: rgb(122, 90, 60); margin-top: 6px;"><%= group.note %></div><% } %><% if (group.label) { %></div><% } %><% } %></div></div>
