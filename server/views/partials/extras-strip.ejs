<%# Strip "Extras +$13 c/u" (bebidas) — verbatim %>
<%
  const exClasses = [];
  if (typeof fxDelay === 'number') exClasses.push('fx-in');
  if (extras.accent) exClasses.push('fx-accent');
%>
<div data-zone="extras"<%- exClasses.length ? ` class="${exClasses.join(' ')}"` : '' %> style="position: absolute; left: 64px; right: 64px; bottom: 116px;<%- typeof fxDelay === 'number' ? ` --fx-delay: ${fxDelay}s;` : '' %>"><div style="background: rgba(122, 90, 60, 0.07); border: 1px solid rgba(122, 90, 60, 0.28); border-radius: 14px; padding: 12px 26px; display: flex; align-items: center; gap: 22px;"><div style="flex: 0 0 auto; display: flex; flex-direction: column; border-right: 1px solid rgba(122, 90, 60, 0.28); padding-right: 20px;"><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 600; font-size: 30px; color: rgb(42, 38, 32); line-height: 1;"><%= extras.title %></span><span style="font-family: Archivo, system-ui, sans-serif; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(122, 90, 60); margin-top: 3px;">+$<%= extras.price %><span> <%= extras.unit %></span></span></div><div style="flex: 1 1 0%; display: flex; justify-content: space-between; gap: 10px;"><% for (const ex of extras.items) { %><div style="display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1 1 0%; min-width: 0px;"><img src="/assets/icons/<%= ex.icon %>.png" alt="" style="width: 64px; height: 64px; display: block;"><span style="font-family: Archivo, system-ui, sans-serif; font-size: 14px; font-weight: 500; color: rgb(42, 38, 32); text-align: center; line-height: 1.1;"><%= ex.label %></span></div><% } %></div></div></div>
