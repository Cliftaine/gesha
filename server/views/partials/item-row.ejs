<%#
  Fila de item — 3 formas: price único / prices por tamaño (columnas 58px) / variants.
  `S` trae los literales de estilo según densidad del menú (alimentos vs bebidas).
  `sizeIds` son los tamaños visibles de la categoría (columna vacía si el item no lo tiene).
%>
<% const hidePrice = !!(locals.show && locals.show.price === false); const hideDesc = !(locals.show && locals.show.description); %><div<%- item.accent ? ' class="fx-accent"' : '' %> style="padding: <%= S.rowPad %>; border-bottom: 1px solid rgba(122, 90, 60, 0.16);"><div style="display: flex; align-items: flex-start;"><span style="flex: 1 1 0%; min-width: 0px; padding-right: 14px; font-family: Archivo, system-ui, sans-serif; font-weight: 500; font-size: <%= S.nameSize %>; line-height: 1.12; color: rgb(42, 38, 32);"><%= item.name %><% if (item.qualifier) { %><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-style: italic; font-weight: 400; font-size: 22px; color: rgb(126, 116, 104); margin-left: 10px;"><%= item.qualifier %></span><% } %></span><% if (hidePrice) { %><% } else if (item.prices) { %><span style="display: flex; gap: 6px; flex: 0 0 auto;"><% for (const sid of sizeIds) { %><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: <%= S.priceSize %>; line-height: 1; color: rgb(122, 90, 60); width: 58px; text-align: right; white-space: nowrap;"><%= item.prices[sid] != null ? '$' + item.prices[sid] : '' %></span><% } %></span><% } else if (item.price != null) { %><span style="display: flex; gap: 6px; flex: 0 0 auto;"><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: <%= S.priceSize %>; line-height: 1; color: rgb(122, 90, 60); width: auto; text-align: right; white-space: nowrap;">$<%= item.price %></span></span><% } %></div><% if (item.variants) { %><%- include('variant-grid', { item }) %><% } %><% if (item.note) { %><div style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-style: italic; font-size: <%= S.noteSize %>; color: rgb(126, 116, 104); margin-top: <%= item.variants ? '4px' : '1px' %>;"><%= item.note %></div><% } %><% if (item.description && !hideDesc) { %><div style="font-family: Archivo, system-ui, sans-serif; font-size: 18px; font-weight: 400; line-height: 1.3; color: rgb(126, 116, 104); margin-top: 3px; max-width: 92%;"><%= item.description %></div><% } %><% if (item.flavors) { %><div style="font-family: Archivo, system-ui, sans-serif; font-size: 17px; font-weight: 500; color: rgb(122, 90, 60); margin-top: 3px; letter-spacing: 0.01em;"><%= item.flavors %></div><% } %></div>
