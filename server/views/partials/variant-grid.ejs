<%# Grid de variantes con dotted leaders — 1 o 2 columnas (item.variantCols) %>
<div style="display: grid; grid-template-columns: <%= item.variantCols === 1 ? '1fr' : '1fr 1fr' %>; gap: 7px 26px; margin-top: 5px;"><% for (const v of item.variants) { %><div style="display: flex; align-items: baseline; gap: 8px; min-width: 0px;"><span style="font-family: Archivo, system-ui, sans-serif; font-size: 21px; font-weight: 500; line-height: 1.15; color: rgb(42, 38, 32); flex: 0 1 auto; min-width: 0px;"><%= v.name %></span><span style="flex: 1 1 0%; border-bottom: 1px dotted rgba(122, 90, 60, 0.28); transform: translateY(-4px);"></span><span style="font-family: &quot;Cormorant Garamond&quot;, Georgia, serif; font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 24px; line-height: 1; color: rgb(122, 90, 60); white-space: nowrap; flex: 0 0 auto;">$<%= v.price %></span></div><% } %></div>
