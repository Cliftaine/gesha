<%# Strip de fotos (bebidas) — reemplaza <image-slot> con el mismo styling de placeholder %>
<div data-zone="image-strip" style="position: absolute; left: 64px; right: 64px; bottom: 250px; display: flex; gap: 16px;"><% for (const slot of imageStrip) { %><div style="flex: 1 1 0%;"><div style="width: 100%; height: 176px; display: block; background: rgb(239, 231, 217); border: 1px solid rgba(122, 90, 60, 0.28); border-radius: 16px; overflow: hidden; position: relative;"><% if (slot.src) { %><img src="<%= slot.src %>" alt="" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;"><% } else { %><div style="position: absolute; inset: 0px; display: flex; align-items: center; justify-content: center; font-family: Archivo, system-ui, sans-serif; font-size: 14px; color: rgba(122, 90, 60, 0.55);"><%= slot.placeholder %></div><% } %></div></div><% } %></div>
